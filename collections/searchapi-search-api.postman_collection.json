{
  "item": [
    {
      "id": "6dfab4fd-f87c-4a0d-b7b5-4fb8056ffe8e",
      "name": "search",
      "description": {
        "content": "Real-time SERP / search-data retrieval across supported engines.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1573bc50-069d-40d1-9843-247a68170ad0",
          "name": "Run a search against a chosen engine",
          "request": {
            "name": "Run a search against a chosen engine",
            "description": {
              "content": "Executes a real-time search on the engine named by `engine` and returns structured JSON. The set of accepted parameters and the populated response blocks depend on the selected engine; the parameters below are those common to the Google web-search engine (the reference engine). See the per-engine docs pages for engine-specific parameters (e.g. `ll` for `google_maps`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "engine",
                  "value": "<string>",
                  "description": "(Required) Search engine to query. SearchApi supports 100+ engines. Common values include `google`, `google_maps`, `google_news`, `google_scholar`, `google_images`, `google_videos`, `google_shopping`, `google_trends`, `google_jobs`, `google_autocomplete`, `google_lens`, `google_ai_mode`, `bing`, `duckduckgo`, `yahoo`, `yandex`, `baidu`, `youtube`, `amazon_search`, `walmart_search`, `ebay_search`."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Search query. Supports engine search operators (e.g. `site:`, `inurl:`). For some engines this parameter carries the engine's primary input (e.g. a place query for `google_maps`)."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "API key. Optional here because authentication is normally supplied via the `Authorization: Bearer <key>` header; provide it as a query parameter only if you are not using the header."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Geographic location from which the search is executed. Cannot be combined with `uule`."
                },
                {
                  "disabled": false,
                  "key": "uule",
                  "value": "<string>",
                  "description": "Google-encoded location string. Cannot be combined with `location`."
                },
                {
                  "disabled": false,
                  "key": "device",
                  "value": "desktop",
                  "description": "Device type to emulate."
                },
                {
                  "disabled": false,
                  "key": "gl",
                  "value": "us",
                  "description": "Two-letter country code for the results (e.g. `us`, `gb`)."
                },
                {
                  "disabled": false,
                  "key": "hl",
                  "value": "en",
                  "description": "Two-letter interface language code (e.g. `en`, `es`)."
                },
                {
                  "disabled": false,
                  "key": "lr",
                  "value": "<string>",
                  "description": "Restrict results to documents in a given language, in `lang_{code}` form (e.g. `lang_en`)."
                },
                {
                  "disabled": false,
                  "key": "cr",
                  "value": "<string>",
                  "description": "Restrict results to documents originating from a given country."
                },
                {
                  "disabled": false,
                  "key": "safe",
                  "value": "blur",
                  "description": "SafeSearch filtering level."
                },
                {
                  "disabled": false,
                  "key": "nfpr",
                  "value": "<integer>",
                  "description": "Set to `1` to exclude results from auto-corrected queries."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<integer>",
                  "description": "Set to `0` to disable the \"Similar/Omitted results\" duplicate filters."
                },
                {
                  "disabled": false,
                  "key": "verbatim",
                  "value": "<boolean>",
                  "description": "Force exact-keyword (verbatim) matching."
                },
                {
                  "disabled": false,
                  "key": "kgmid",
                  "value": "<string>",
                  "description": "Knowledge Graph entity id (`/m/` or `/g/` form) to fetch a specific entity."
                },
                {
                  "disabled": false,
                  "key": "time_period",
                  "value": "<string>",
                  "description": "Restrict results to a relative time window."
                },
                {
                  "disabled": false,
                  "key": "time_period_min",
                  "value": "<string>",
                  "description": "Custom time-window start date, `MM/DD/YYYY`."
                },
                {
                  "disabled": false,
                  "key": "time_period_max",
                  "value": "<string>",
                  "description": "Custom time-window end date, `MM/DD/YYYY`."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Results page number."
                },
                {
                  "disabled": false,
                  "key": "ll",
                  "value": "<string>",
                  "description": "GPS coordinates for engines that accept them (notably `google_maps`), in `@latitude,longitude,zoom` (e.g. `@40.7455096,-74.0083012,14z`) form."
                },
                {
                  "disabled": false,
                  "key": "optimization_strategy",
                  "value": "<string>",
                  "description": "Request optimization approach."
                },
                {
                  "disabled": false,
                  "key": "zero_retention",
                  "value": "<boolean>",
                  "description": "Disable logging/storage of the request and response (Enterprise plans only)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
